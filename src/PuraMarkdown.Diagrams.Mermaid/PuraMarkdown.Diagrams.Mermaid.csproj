<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PuraMarkdown.Diagrams.Mermaid</RootNamespace>
    <Description>PuraMarkdown 官方可选插件：Mermaid 图表（基于 Mermaider，纯 .NET）。</Description>
    <PackageId>PuraMarkdown.Diagrams.Mermaid</PackageId>
    <Authors>PuraMarkdown contributors</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>avalonia;markdown;mermaid;diagram</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mermaider" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PuraMarkdown\PuraMarkdown.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>




