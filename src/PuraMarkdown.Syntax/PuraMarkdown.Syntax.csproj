<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PuraMarkdown.Syntax</RootNamespace>
    <AssemblyName>PuraMarkdown.Syntax</AssemblyName>
    <PackageId>PuraMarkdown.Syntax</PackageId>
    <Description>PuraMarkdown 语法层：Markdig 解析、PuraDocument、诊断、大纲与流式扫描；不依赖 Avalonia。</Description>
    <PackageTags>markdown;markdig;syntax;parser;streaming</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Markdig" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
</Project>

