<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>PuraMarkdown</RootNamespace>
    <AssemblyName>PuraMarkdown</AssemblyName>
    <PackageId>PuraMarkdown</PackageId>
    <Authors>PuraMarkdown contributors</Authors>
    <Description>Avalonia 高性能只读 Markdown 渲染控件：Markdig 解析、增量流式、虚拟化、插件化渲染，内置 Agent 交互组件、Chat 消息列表与测试工具。</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>avalonia;markdown;agent;llm;chat;streaming</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PuraMarkdown.Syntax\PuraMarkdown.Syntax.csproj" />
  </ItemGroup>
</Project>
